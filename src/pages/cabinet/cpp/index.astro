---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { conceptSlugFromId, getDrawerMetadata } from "@/lib/technicalCabinet";

const entries = await getCollection("cppCabinet");
const drawers = entries
  .map((entry) => getDrawerMetadata(conceptSlugFromId(entry.id)))
  .sort((left, right) => left.title.localeCompare(right.title));
---

<Layout
  title="C++ Cabinet • Matt Twells"
  description="Personal C++ notes and examples organized for retrieval rather than as a linear course."
  constrained={true}
>
  <section class="py-12">
    <p class="font-mono text-sm uppercase tracking-[0.3em] text-[#c084fc]">
      ~/cabinet/cpp
    </p>
    <h1 class="site-section-title mt-3 text-4xl font-bold md:text-5xl">
      C++ Cabinet
    </h1>
    <p
      class="mt-5 max-w-3xl text-base leading-relaxed text-white/75 md:text-lg"
    >
      Concepts I have studied, explanations written in the language that made
      them click, and small examples that are rebuilt instead of merely trusted.
      This is a file cabinet, not a textbook—open the drawer you need.
    </p>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {
        drawers.map((drawer) => (
          <article class="article-card rounded-xl border border-white/10 bg-white/5 p-6">
            <div class="flex items-start justify-between gap-4">
              <p class="font-mono text-xs uppercase tracking-[0.25em] text-[#5eead4]">
                {drawer.examples.length}{" "}
                {drawer.examples.length === 1 ? "example" : "examples"}
              </p>
              <p class="font-mono text-xs text-white/45">
                {drawer.sectionCount} sections
              </p>
            </div>
            <h2 class="mt-4 text-2xl font-semibold text-white">
              <a
                href={`/cabinet/cpp/${drawer.slug}/`}
                class="article-card-title hover:text-[#5eead4]"
              >
                {drawer.title}
              </a>
            </h2>
            <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-white/65">
              {drawer.summary}
            </p>
            <a
              href={`/cabinet/cpp/${drawer.slug}/`}
              class="article-card-cta mt-5 inline-block font-mono text-sm"
            >
              open drawer →
            </a>
          </article>
        ))
      }
    </div>

    <section class="mt-14 border-t border-dashed border-white/20 pt-8">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-[#c084fc]">
        Project-starting tools
      </p>
      <article
        class="article-card mt-5 rounded-xl border border-white/10 bg-white/5 p-6"
      >
        <h2 class="text-2xl font-semibold text-white">
          <a
            href="/cabinet/cpp/project-start/"
            class="article-card-title hover:text-[#5eead4]"
          >
            The Blank Page Killer
          </a>
        </h2>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-white/65">
          A reusable C++ project-starting template that keeps architecture and
          decisions mine while making research, syntax lookup, scope control,
          and progress receipts explicit parts of the work.
        </p>
        <a
          href="/cabinet/cpp/project-start/"
          class="article-card-cta mt-5 inline-block font-mono text-sm"
        >
          open tool →
        </a>
      </article>
    </section>
  </section>
</Layout>
